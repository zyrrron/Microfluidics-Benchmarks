// Pump-like process is unary ~, not a #MAP mode keyword.
// #MAP "PUMP" "pump" is rejected. Same pattern as map_mixer.lfr:
//   #MAP "<TECH>" "~" then assign y = ~x;
// Compile then hangs CONTROL PORTs cp1..cp3 onto the three internal
// valves (PUMP pads 3, 4, 5), matching handwritten Primitive/Pump.mint.
module map_pump(
    finput in,
    foutput out
);
    #MAP "PUMP" "~"
    assign out = ~in;
endmodule
