// test_device_v1_MUX_4to1 — 4-to-1 distribute tree (standalone).
//
//   in0..in3 --(c_select)--> out
//
// Same 4-to-1 valve tree as test_device_MUX_4to1.lfr (distribute + case).
// Placement differences vs that file are PR orientation, not topology.
// Do not instantiate this from a parent: distribute inside an imported
// module does not emit valves. The 1-port must be a real foutput.
module test_device_v1_MUX_4to1(
    finput in0, in1, in2, in3,
    foutput out,
    control [0:1] c_select
);
    distribute@(c_select)
    begin
        case(c_select)
            2'b00 : out <= in0;
            2'b01 : out <= in1;
            2'b10 : out <= in2;
            2'b11 : out <= in3;
        endcase
    end
endmodule
