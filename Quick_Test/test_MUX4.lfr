// test_MUX4: 1-to-4 MINT MUX from LFR via #MAP "MUX" "assign" (no distribute tree).
// Geometry matches Super_MUX_4.mint: leafSpace=4000, stageSpace=6000, channel widths 600.
// Compile should emit the MUX plus I/O ports, four CONTROL pads on mux ports 6-9,
// and no extra port-to-port flow shortcuts.
module test_MUX4(
    finput in,
    foutput [0:3] out
);
    #MAP "MUX" "assign"
    assign out[0:3] = in;
endmodule
